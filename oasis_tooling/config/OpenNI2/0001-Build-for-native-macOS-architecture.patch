From: Garrett Brown <eigendebugger@gmail.com>
Date: Sun, 22 Nov 2026 21:00:00 -0800
Subject: [PATCH] Build for native macOS architecture

Treat Apple Silicon as a 64-bit target instead of applying ARMv7 flags,
and stop requesting unsupported i386 slices on current Intel Macs.

diff --git a/ThirdParty/PSCommon/BuildSystem/CommonDefs.mak b/ThirdParty/PSCommon/BuildSystem/CommonDefs.mak
--- a/ThirdParty/PSCommon/BuildSystem/CommonDefs.mak
+++ b/ThirdParty/PSCommon/BuildSystem/CommonDefs.mak
@@ -15,6 +15,8 @@ else ifneq (,$(findstring i686,$(MACHINE)))
 	HOST_PLATFORM = x86
 else ifneq (,$(findstring i386,$(MACHINE)))
 	HOST_PLATFORM = x86
+else ifneq (,$(filter arm64 aarch64,$(MACHINE)))
+	HOST_PLATFORM = Arm64
 else ifneq (,$(findstring arm,$(MACHINE)))
 	HOST_PLATFORM = Arm
 else
diff --git a/ThirdParty/PSCommon/BuildSystem/Platform.Arm64 b/ThirdParty/PSCommon/BuildSystem/Platform.Arm64
new file mode 100644
--- /dev/null
+++ b/ThirdParty/PSCommon/BuildSystem/Platform.Arm64
@@ -0,0 +1,8 @@
+# Copyright (C) 2026 Garrett Brown
+# This file is part of OASIS - https://github.com/eigendude/OASIS
+# SPDX-License-Identifier: Apache-2.0
+# See the file LICENSE.txt for more information.
+
+ifeq "$(CFG)" "Release"
+    CFLAGS += -O3
+endif
diff --git a/ThirdParty/PSCommon/BuildSystem/Platform.x86 b/ThirdParty/PSCommon/BuildSystem/Platform.x86
--- a/ThirdParty/PSCommon/BuildSystem/Platform.x86
+++ b/ThirdParty/PSCommon/BuildSystem/Platform.x86
@@ -6,9 +6,8 @@ ifndef SSE_GENERATION
 endif
 
 ifeq ("$(OSTYPE)","Darwin")
-	# Making the binary a universal one (x86 + x64)
-	CFLAGS += -arch i386 -arch x86_64
-	LDFLAGS += -arch i386 -arch x86_64
+	CFLAGS += -arch $(MACHINE)
+	LDFLAGS += -arch $(MACHINE)
 endif
 
 ifeq ($(SSE_GENERATION), 2)
