From: Garrett Brown <eigendebugger@gmail.com>
Date: Sun, 22 Nov 2026 22:20:00 -0800
Subject: [PATCH] Use Eigen imported target

diff --git a/depth_image_proc/CMakeLists.txt b/depth_image_proc/CMakeLists.txt
--- a/depth_image_proc/CMakeLists.txt
+++ b/depth_image_proc/CMakeLists.txt
@@ -13,7 +13,7 @@
 find_package(ament_cmake_auto REQUIRED)
 ament_auto_find_build_dependencies()
 
-find_package(Eigen3 REQUIRED)
+find_package(Eigen3 REQUIRED NO_MODULE)
 
 find_package(OpenCV REQUIRED)
 
@@ -73,7 +73,7 @@
   EXECUTABLE register_node
 )
 
-target_link_libraries(${PROJECT_NAME} ${OpenCV_LIBRARIES})
+target_link_libraries(${PROJECT_NAME} ${OpenCV_LIBRARIES} Eigen3::Eigen)
 
 if(BUILD_TESTING)
   find_package(ament_lint_auto REQUIRED)
