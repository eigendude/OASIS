From: Garrett Brown <eigendebugger@gmail.com>
Date: Sun, 22 Nov 2026 21:00:00 -0800
Subject: [PATCH] Fix Ogre dependencies, SDK and architecture on macOS

Build Ogre for the host architecture so it matches Homebrew libraries.
The unescaped universal architecture list also passes x86_64 to CMake
as an unrelated argument.

Vendor Ogre's pinned zziplib dependency on macOS so its requested ZIP
archive support remains available without an unavailable Homebrew formula.

Keep loader-relative runtime paths so installed plugins can find Ogre and
their sibling plugins after leaving the vendor build directory.

Replace Ogre's shell pipeline inside execute_process with xcrun. CMake
does not interpret the pipe, so xcodebuild receives the head arguments
and its usage output becomes the SDK path.

diff --git a/rviz_ogre_vendor/CMakeLists.txt b/rviz_ogre_vendor/CMakeLists.txt
index 2fa32541..4512b141 100644
--- a/rviz_ogre_vendor/CMakeLists.txt
+++ b/rviz_ogre_vendor/CMakeLists.txt
@@ -34,13 +34,36 @@ else()
 endif()
 
 set(OGRE_CMAKE_ARGS)
-if(NOT WIN32)
+if(APPLE)
+  list(APPEND OGRE_CMAKE_ARGS -DCMAKE_SKIP_INSTALL_RPATH:BOOL=OFF)
+elseif(NOT WIN32)
   list(APPEND OGRE_CMAKE_ARGS -DCMAKE_SKIP_INSTALL_RPATH:BOOL=ON)
 endif()
 
 if(APPLE)
   list(APPEND OGRE_CMAKE_ARGS -DOGRE_ENABLE_PRECOMPILED_HEADERS:BOOL=OFF)
-  list(APPEND OGRE_CMAKE_ARGS -DCMAKE_OSX_ARCHITECTURES=arm64;x86_64)
+  list(APPEND OGRE_CMAKE_ARGS -DCMAKE_OSX_ARCHITECTURES=${CMAKE_SYSTEM_PROCESSOR})
+
+  # Match Ogre's bundled ZIP dependency while using the ROS vendor lifecycle
+  ament_vendor(zzip_vendor
+    VCS_URL https://github.com/gdraheim/zziplib.git
+    VCS_VERSION v0.13.71
+    CMAKE_ARGS
+      -DBUILD_SHARED_LIBS:BOOL=OFF
+      -DBUILD_STATIC_LIBS:BOOL=ON
+      -DCMAKE_POSITION_INDEPENDENT_CODE:BOOL=ON
+      -DCMAKE_OSX_ARCHITECTURES=${CMAKE_SYSTEM_PROCESSOR}
+      -DZZIPMMAPPED:BOOL=OFF
+      -DZZIPFSEEKO:BOOL=OFF
+      -DZZIPCOMPAT:BOOL=OFF
+      -DZZIPLIBTOOL:BOOL=OFF
+      -DZZIPWRAP:BOOL=OFF
+      -DZZIPSDL:BOOL=OFF
+      -DZZIPBINS:BOOL=OFF
+      -DZZIPTEST:BOOL=OFF
+      -DZZIPDOCS:BOOL=OFF
+      -DCMAKE_POLICY_VERSION_MINIMUM=3.20
+  )
 endif()
 
 ament_vendor(ogre_vendor
@@ -75,6 +98,10 @@ ament_vendor(ogre_vendor
   PATCHES patches
 )
 
+if(APPLE)
+  externalproject_add_stepdependencies(ogre_vendor configure zzip_vendor)
+endif()
+
 if(BUILD_TESTING)
   find_package(ament_lint_auto REQUIRED)
   ament_lint_auto_find_test_dependencies()
diff --git a/rviz_ogre_vendor/patches/0007-fix-macos-sdk.patch b/rviz_ogre_vendor/patches/0007-fix-macos-sdk.patch
new file mode 100644
index 00000000..65f59897
--- /dev/null
+++ b/rviz_ogre_vendor/patches/0007-fix-macos-sdk.patch
@@ -0,0 +1,31 @@
+diff --git a/CMakeLists.txt b/CMakeLists.txt
+--- a/CMakeLists.txt
++++ b/CMakeLists.txt
+@@ -246,8 +246,12 @@ elseif (APPLE AND NOT APPLE_IOS)
+ 
+   set(XCODE_ATTRIBUTE_SDKROOT macosx)
+   if(CMAKE_GENERATOR STREQUAL "Unix Makefiles")
+-    execute_process(COMMAND xcodebuild -version -sdk "${XCODE_ATTRIBUTE_SDKROOT}" Path | head -n 1 OUTPUT_VARIABLE CMAKE_OSX_SYSROOT)
+-    string(REGEX REPLACE "(\r?\n)+$" "" CMAKE_OSX_SYSROOT "${CMAKE_OSX_SYSROOT}")
++    execute_process(
++      COMMAND xcrun --sdk "${XCODE_ATTRIBUTE_SDKROOT}" --show-sdk-path
++      OUTPUT_VARIABLE CMAKE_OSX_SYSROOT
++      OUTPUT_STRIP_TRAILING_WHITESPACE
++      COMMAND_ERROR_IS_FATAL ANY
++    )
+   else()
+     set(CMAKE_OSX_SYSROOT macosx)
+   endif()
+@@ -436,7 +440,11 @@
+ include(ConfigureBuild)
+ 
+-set(CMAKE_INSTALL_RPATH "${CMAKE_INSTALL_PREFIX}/${OGRE_LIB_DIRECTORY}")
++if(APPLE)
++  set(CMAKE_INSTALL_RPATH "@loader_path;@loader_path/..")
++else()
++  set(CMAKE_INSTALL_RPATH "${CMAKE_INSTALL_PREFIX}/${OGRE_LIB_DIRECTORY}")
++endif()
+ set(CMAKE_INSTALL_RPATH_USE_LINK_PATH TRUE)
+ 
+ ###################################################################
+ # disable way too common compiler warnings on project level
