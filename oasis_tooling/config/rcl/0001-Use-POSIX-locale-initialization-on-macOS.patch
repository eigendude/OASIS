From: Garrett Brown <eigendebugger@gmail.com>
Subject: [PATCH] Use POSIX locale initialization on macOS

Darwin provides pthread_once instead of the optional C11 threads API.
Use the equivalent POSIX initializer and include xlocale.h for the
per-thread locale functions used by the YAML number parser.

diff --git a/rcl_yaml_param_parser/src/parse.c b/rcl_yaml_param_parser/src/parse.c
index b39baec..88c87e1 100644
--- a/rcl_yaml_param_parser/src/parse.c
+++ b/rcl_yaml_param_parser/src/parse.c
@@ -20,6 +20,9 @@
 
 #ifdef _WIN32
 #include <windows.h>
+#elif defined(__APPLE__)
+#include <pthread.h>
+#include <xlocale.h>
 #else
 #include <threads.h>
 #endif
@@ -804,7 +807,11 @@ BOOL CALLBACK init_c_locale(
 }
 #else
 static locale_t c_locale = 0;
+#ifdef __APPLE__
+static pthread_once_t c_locale_once_flag = PTHREAD_ONCE_INIT;
+#else
 static once_flag c_locale_once_flag = ONCE_FLAG_INIT;
+#endif
 
 static void init_c_locale(void)
 {
@@ -833,8 +840,12 @@ static double strtod_locale_independent(const char *restrict nptr, char **restri
   }
 
   return _strtod_l(nptr, endptr, c_locale);
+#else
+#ifdef __APPLE__
+  pthread_once(&c_locale_once_flag, init_c_locale);
 #else
   call_once(&c_locale_once_flag, init_c_locale);
+#endif
 
   if (0 == c_locale) {
     if (NULL != endptr) {
